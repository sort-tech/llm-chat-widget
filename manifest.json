{
  "manifest_version": 3,
  "name": "페이지 챗봇 (Page Chatbot)",
  "short_name": "페이지 챗봇",
  "version": "1.0.0",
  "description": "현재 보고 있는 웹페이지를 읽고 그 내용을 근거로 답하는 사이드 패널 AI 챗봇. LiteLLM 등 OpenAI 호환 서버에 연결됩니다.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "페이지 챗봇 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/panel.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "페이지 챗봇 패널 열기/닫기"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["src/sidepanel/panel.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
